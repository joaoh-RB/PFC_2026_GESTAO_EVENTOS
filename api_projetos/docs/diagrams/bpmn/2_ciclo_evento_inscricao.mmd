flowchart TD
    %% Processo BPMN 2: Criação de Evento, Google Agenda e Inscrição
    
    subgraph Pool_Evento ["BPMN: Processo de Criação de Evento, Google Agenda e Inscrições"]
        
        subgraph Lane_Organizador ["Raia: Organizador (Professor / Secretaria)"]
            Start2(["Início: Demanda de evento"]) --> Task_CriaEvt["Cadastrar dados do evento\n(Título, Vagas, Datas, Cursos Permitidos)"]
            Task_CriaEvt --> Task_EnviaEvt["Submeter criação do evento"]
            Task_AnalisaSolicitacao["Acessar fila de eventos solicitados\ne avaliar proposta do aluno"] --> Gate_AprovaEvt{"Aprovar\nevento?"}
            Gate_AprovaEvt -- Sim --> Task_AprovaEvt["Submeter aprovação do evento"]
            Gate_AprovaEvt -- Não --> Task_ReprovaEvt["Submeter reprovação do evento"]
        end

        subgraph Lane_Sistema ["Raia: Sistema (Back-end API)"]
            Task_EnviaEvt --> Task_ValidaEvt["Validar dados (CreateEventValidator)\ne cursos elegíveis"]
            Task_EnviaSolicitacaoEvt --> Task_ValidaEvt
            Task_ValidaEvt --> Gate_PerfilCriador{"Criado por\nAluno?"}
            Gate_PerfilCriador -- Sim --> Task_SalvaSolicitado["Persistir Evento no banco\n(EventStatus: Solicitado)"]
            Task_SalvaSolicitado --> Task_AnalisaSolicitacao
            Task_ReprovaEvt --> Task_AtualizaEvtReprovado["Atualizar status do evento\n(EventStatus: Reprovado)"]
            Gate_PerfilCriador -- Não --> Task_ChamaGoogle["Chamar GoogleCalendarService\npara criar evento na agenda oficial"]
            Task_AprovaEvt --> Task_ChamaGoogle
            Task_RecebeGoogle["Persistir/Atualizar Evento (EventStatus: Agendado)\ncom GoogleCalendarEventId"] --> Task_PublicaEvt["Publicar evento para os\ncursos autorizados"]
            
            Task_FiltraEvts["Filtrar eventos ativos\npermitidos para o curso do aluno"] --> Task_ExibeDisponiveis["Exibir eventos no painel"]
            
            Task_ProcessaInscr["Verificar capacidade\ne inscrições ativas"] --> Gate_Vagas{"Há vagas\ndisponíveis?"}
            Gate_Vagas -- Não --> Task_RecusaInscr["Informar evento lotado"]
            Gate_Vagas -- Sim --> Task_CriaInscr["Criar EventStudent\n(Status: Confirmed)"]
            Task_CriaInscr --> Fork_Inscr{{"Gateway Paralelo"}}
            
            Fork_Inscr --> Task_EnviaEmailConf["Enviar e-mail com confirmação\ne detalhes do evento"]
            Fork_Inscr --> Task_ChecaSyncCal["Registrar EventAddedToCalendar\n(se solicitado pelo aluno)"]
            
            Task_EnviaEmailConf --> Join_Inscr{{"Junção"}}
            Task_ChecaSyncCal --> Join_Inscr
            Join_Inscr --> End_Sucesso(["Fim: Inscrição Confirmada"])
        end

        subgraph Lane_Google ["Raia: Google Calendar API"]
            Task_ChamaGoogle --> Task_GoogleApi["Criar entrada de evento\nna agenda do Google"]
            Task_GoogleApi --> Task_RetornaGoogleId["Retornar googleEventId gerado"]
            Task_RetornaGoogleId --> Task_RecebeGoogle
        end

        subgraph Lane_Aluno ["Raia: Aluno"]
            Start_SolicitaEvt(["Início: Proposta de evento pelo aluno"]) --> Task_PreencheSolicitacaoEvt["Cadastrar dados do evento\n(Título, Vagas, Datas, Cursos Permitidos)"]
            Task_PreencheSolicitacaoEvt --> Task_EnviaSolicitacaoEvt["Submeter solicitação de criação de evento"]
            Task_AtualizaEvtReprovado --> End_EvtReprovado(["Fim: Solicitação de Evento Reprovada"])

            Task_PublicaEvt --> Task_AcessaPortal["Acessar catálogo de eventos"]
            Task_AcessaPortal --> Task_FiltraEvts
            Task_ExibeDisponiveis --> Task_SolicitaInscr["Selecionar evento e clicar\nem 'Inscrever-se'"]
            Task_SolicitaInscr --> Task_ProcessaInscr
            Task_RecusaInscr --> End_Lotado(["Fim: Inscrição Não Realizada"])
            End_Sucesso -.-> Task_RecebeConf["Recebe comprovante e detalhes"]
        end

    end
